FROM node:22-bookworm-slim AS node

FROM golang:1.26-alpine AS build

ARG VERSION=dev
ARG COMMIT=none
ARG DATE=unknown

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build \
  -ldflags "-s -w \
    -X github.com/aslafy-z/hauth/internal/version.Version=${VERSION} \
    -X github.com/aslafy-z/hauth/internal/version.Commit=${COMMIT} \
    -X github.com/aslafy-z/hauth/internal/version.Date=${DATE}" \
  -o /out/hauth ./cmd/hauth

FROM codercom/enterprise-base:ubuntu

USER root
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gnupg \
    gzip \
    tar \
    unzip \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

# Node comes from the official image; HAPI is baked in at build time so
# workspace startup does not depend on the npm registry.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && npm install -g @twsxtd/hapi \
  && npm cache clean --force

COPY --from=build /out/hauth /usr/local/bin/hauth
COPY deploy/docker/hapi/start-hapi.sh /opt/hauth/start-hapi.sh
RUN chmod +x /opt/hauth/start-hapi.sh

ENV PATH="/home/coder/.local/bin:${PATH}"

USER coder
RUN mkdir -p /home/coder/project /home/coder/.local/bin /home/coder/.hapi
WORKDIR /home/coder/project
